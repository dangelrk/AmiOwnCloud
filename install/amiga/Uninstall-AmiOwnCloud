; Entfernt die von Install-AmiOwnCloud installierten Dateien.
; SPDX-License-Identifier: GPL-3.0-or-later
; Copyright (C) 2026 Ronny Krueger
;
; Aufruf in einer Shell:  Execute Uninstall-AmiOwnCloud
;
; Vorher AmiOwnCloudSync über Exchange beenden. Der OWNCLOUD:-Handler
; lässt sich nicht aushängen - er verschwindet erst nach einem Neustart.

FailAt 21

Echo ""
Echo "AmiOwnCloud - Deinstallation"
Echo "============================"
Echo "Antworten jeweils mit  y = ja  oder  n = nein  und RETURN."
Echo ""
Ask "AmiOwnCloud-Programme wirklich entfernen? (y/n)"
If NOT WARN
  Echo "Abgebrochen - nichts geändert."
  Quit 0
EndIf

; ---- OWNCLOUD:-Handler + AmiOwnCloudPrefs
If EXISTS L:amiowncloud-handler
  Delete L:amiowncloud-handler QUIET
EndIf
If EXISTS L:amiowncloud-worker
  Delete L:amiowncloud-worker QUIET
EndIf
If EXISTS DEVS:DOSDrivers/OWNCLOUD
  Delete DEVS:DOSDrivers/OWNCLOUD QUIET
EndIf
If EXISTS DEVS:DOSDrivers/OWNCLOUD.info
  Delete DEVS:DOSDrivers/OWNCLOUD.info QUIET
EndIf
If EXISTS SYS:Storage/DOSDrivers/OWNCLOUD
  Delete SYS:Storage/DOSDrivers/OWNCLOUD QUIET
EndIf
If EXISTS SYS:Storage/DOSDrivers/OWNCLOUD.info
  Delete SYS:Storage/DOSDrivers/OWNCLOUD.info QUIET
EndIf
If EXISTS SYS:Prefs/AmiOwnCloudPrefs
  Delete SYS:Prefs/AmiOwnCloudPrefs QUIET
EndIf
If EXISTS SYS:Prefs/AmiOwnCloudPrefs.info
  Delete SYS:Prefs/AmiOwnCloudPrefs.info QUIET
EndIf

; ---- AmiOwnCloudSync + AmiOwnCloudSyncPrefs
If EXISTS SYS:Tools/Commodities/AmiOwnCloudSync
  Delete SYS:Tools/Commodities/AmiOwnCloudSync QUIET
EndIf
If EXISTS SYS:Tools/Commodities/AmiOwnCloudSync.info
  Delete SYS:Tools/Commodities/AmiOwnCloudSync.info QUIET
EndIf
If EXISTS SYS:WBStartup/AmiOwnCloudSync
  Delete SYS:WBStartup/AmiOwnCloudSync QUIET
EndIf
If EXISTS SYS:WBStartup/AmiOwnCloudSync.info
  Delete SYS:WBStartup/AmiOwnCloudSync.info QUIET
EndIf
If EXISTS SYS:Prefs/AmiOwnCloudSyncPrefs
  Delete SYS:Prefs/AmiOwnCloudSyncPrefs QUIET
EndIf
If EXISTS SYS:Prefs/AmiOwnCloudSyncPrefs.info
  Delete SYS:Prefs/AmiOwnCloudSyncPrefs.info QUIET
EndIf

; ---- Kommandozeilenprogramme
If EXISTS C:amiowncloud-sync
  Delete C:amiowncloud-sync QUIET
EndIf
If EXISTS C:amiowncloud-synctest
  Delete C:amiowncloud-synctest QUIET
EndIf

; ---- Handbuch
Assign >NIL: HELP: EXISTS
If NOT WARN
  If EXISTS HELP:AmiOwnCloud.guide
    Delete HELP:AmiOwnCloud.guide QUIET
  EndIf
EndIf

Echo "Programme entfernt."
Echo ""

; ---- Konfiguration (enthält Zugangsdaten)
Echo "Einstellungen: amiowncloud.cfg, AmiOwnCloudSync.cfg, amiowncloud-sync.cfg"
Ask "Auch die Einstellungen löschen? (y/n)"
If WARN
  If EXISTS ENV:amiowncloud.cfg
    Delete ENV:amiowncloud.cfg QUIET
  EndIf
  If EXISTS ENVARC:amiowncloud.cfg
    Delete ENVARC:amiowncloud.cfg QUIET
  EndIf
  If EXISTS ENV:AmiOwnCloudSync.cfg
    Delete ENV:AmiOwnCloudSync.cfg QUIET
  EndIf
  If EXISTS ENVARC:AmiOwnCloudSync.cfg
    Delete ENVARC:AmiOwnCloudSync.cfg QUIET
  EndIf
  If EXISTS ENV:amiowncloud-sync.cfg
    Delete ENV:amiowncloud-sync.cfg QUIET
  EndIf
  If EXISTS ENVARC:amiowncloud-sync.cfg
    Delete ENVARC:amiowncloud-sync.cfg QUIET
  EndIf
  Echo "Einstellungen gelöscht."
EndIf

Echo ""
Echo "Bitte noch von Hand:"
Echo "- In S:User-Startup den Block ;BEGIN AmiOwnCloudSync ... ;END AmiOwnCloudSync"
Echo "  entfernen, falls vorhanden."
Echo "- Die Abgleichsdateien .amicloudsync in den lokalen Ordnern der"
Echo "  Ordnerpaare bleiben erhalten und können gelöscht werden."
Echo "- Neu starten, damit ein gemounteter OWNCLOUD:-Handler verschwindet."
