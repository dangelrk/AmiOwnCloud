; Copyright (C) 2026 Ronny Krueger
;
; Aufruf in einer Shell:  Execute Uninstall-AmiOwnCloud
;
; Vorher AmiCloudSync über Exchange beenden. Der OWNCLOUD:-Handler
; lässt sich nicht aushängen - er verschwindet erst nach einem Neustart.

FailAt 21

Echo ""
Echo "AmiOwnCloud - Deinstallation"
Echo "============================"
Echo "Antworten jeweils mit  y = ja  oder  n = nein  und RETURN."
Echo ""
Ask "AmiOwnCloud-Programme wirklich entfernen? (y/n)"
If NOT WARN
  Echo "Abgebrochen - nichts geändert."
  Quit 0
EndIf

; ---- OWNCLOUD:-Handler + OwnCloudPrefs
If EXISTS L:owncloud-handler
  Delete L:owncloud-handler QUIET
EndIf
If EXISTS L:owncloud-worker
  Delete L:owncloud-worker QUIET
EndIf
If EXISTS DEVS:DOSDrivers/OWNCLOUD
  Delete DEVS:DOSDrivers/OWNCLOUD QUIET
EndIf
If EXISTS DEVS:DOSDrivers/OWNCLOUD.info
  Delete DEVS:DOSDrivers/OWNCLOUD.info QUIET
EndIf
If EXISTS SYS:Storage/DOSDrivers/OWNCLOUD
  Delete SYS:Storage/DOSDrivers/OWNCLOUD QUIET
EndIf
If EXISTS SYS:Storage/DOSDrivers/OWNCLOUD.info
  Delete SYS:Storage/DOSDrivers/OWNCLOUD.info QUIET
EndIf
If EXISTS SYS:Prefs/OwnCloudPrefs
  Delete SYS:Prefs/OwnCloudPrefs QUIET
EndIf
If EXISTS SYS:Prefs/OwnCloudPrefs.info
  Delete SYS:Prefs/OwnCloudPrefs.info QUIET
EndIf

; ---- AmiCloudSync + AmiCloudSyncPrefs
If EXISTS SYS:Tools/Commodities/AmiCloudSync
  Delete SYS:Tools/Commodities/AmiCloudSync QUIET
EndIf
If EXISTS SYS:Tools/Commodities/AmiCloudSync.info
  Delete SYS:Tools/Commodities/AmiCloudSync.info QUIET
EndIf
If EXISTS SYS:WBStartup/AmiCloudSync
  Delete SYS:WBStartup/AmiCloudSync QUIET
EndIf
If EXISTS SYS:WBStartup/AmiCloudSync.info
  Delete SYS:WBStartup/AmiCloudSync.info QUIET
EndIf
If EXISTS SYS:Prefs/AmiCloudSyncPrefs
  Delete SYS:Prefs/AmiCloudSyncPrefs QUIET
EndIf
If EXISTS SYS:Prefs/AmiCloudSyncPrefs.info
  Delete SYS:Prefs/AmiCloudSyncPrefs.info QUIET
EndIf

; ---- Kommandozeilenprogramme
If EXISTS C:webdavsync
  Delete C:webdavsync QUIET
EndIf
If EXISTS C:webdavsynctest
  Delete C:webdavsynctest QUIET
EndIf

; ---- Handbuch
Assign >NIL: HELP: EXISTS
If NOT WARN
  If EXISTS HELP:AmiOwnCloud.guide
    Delete HELP:AmiOwnCloud.guide QUIET
  EndIf
EndIf

Echo "Programme entfernt."
Echo ""

; ---- Konfiguration (enthält Zugangsdaten)
Ask "Auch die Einstellungen (owncloud.cfg, AmiCloudSync.cfg, webdavsync.cfg) löschen? (y/n)"
If WARN
  If EXISTS ENV:owncloud.cfg
    Delete ENV:owncloud.cfg QUIET
  EndIf
  If EXISTS ENVARC:owncloud.cfg
    Delete ENVARC:owncloud.cfg QUIET
  EndIf
  If EXISTS ENV:AmiCloudSync.cfg
    Delete ENV:AmiCloudSync.cfg QUIET
  EndIf
  If EXISTS ENVARC:AmiCloudSync.cfg
    Delete ENVARC:AmiCloudSync.cfg QUIET
  EndIf
  If EXISTS ENV:webdavsync.cfg
    Delete ENV:webdavsync.cfg QUIET
  EndIf
  If EXISTS ENVARC:webdavsync.cfg
    Delete ENVARC:webdavsync.cfg QUIET
  EndIf
  Echo "Einstellungen gelöscht."
EndIf

Echo ""
Echo "Bitte noch von Hand:"
Echo "- In S:User-Startup den Block ;BEGIN AmiCloudSync ... ;END AmiCloudSync"
Echo "  entfernen, falls vorhanden."
Echo "- Die Abgleichsdateien .amicloudsync in den lokalen Ordnern der"
Echo "  Ordnerpaare bleiben erhalten und können gelöscht werden."
Echo "- Neu starten, damit ein gemounteter OWNCLOUD:-Handler verschwindet."
