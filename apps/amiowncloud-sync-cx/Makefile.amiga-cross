# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Ronny Krueger
# AmiOwnCloudSync -- AmigaOS 3.x (VBCC), CROSS-compiled from a host (macOS/
# Linux/Windows) using the toolchain described in
# docs/BUILD.md. Mirrors AmiCloud's apps/cloudsync/Makefile.
# amiga-cross (no oml on the host, so this links directly against the
# lib .o files instead of against .lib archives).
#
# No MUI here (GadTools/Intuition/Commodities only -- see gui.c/
# commodity.c), so no MUI_INC and no mui_stubs.[ch] hack: GadTools and
# Commodities have proper VBCC-native inline stubs in the NDK. No -lamiga
# either -- that's only needed for MUI's DoMethod/DoSuperMethod BOOPSI
# dispatch (see amivcs-gui-mui/Makefile.amiga-cross), which classic
# GadTools never uses.
#
# Build:  export VBCC=/path/to/vbcc     (see docs/BUILD.md)
#         make -f Makefile.amiga-cross

VBCC    ?= /opt/vbcc
CC       = $(VBCC)/bin/vc
TARGET   = +aos68k
CPU      = 68000

RUNTIME_INC = $(VBCC)/targets/m68k-amigaos/include
RUNTIME_LIB = $(VBCC)/targets/m68k-amigaos/lib
NDK_INC     = $(VBCC)/sdk/NDK_3.2/Include_H
NET_INC     = $(VBCC)/sdk/Roadshow/netinclude
AMISSL_INC  = $(VBCC)/sdk/AmiSSL-v5/Developer/include

LIBS_DIR = ../../core
CORE_DIR = $(LIBS_DIR)/libcloudcore
HTTP_DIR = $(LIBS_DIR)/libcloudhttp
FS_DIR   = $(LIBS_DIR)/libcloudfs
SYNC_DIR = $(LIBS_DIR)/libcloudsync

CORE_INC = $(CORE_DIR)/include/cloudcore
HTTP_INC = $(HTTP_DIR)/include/cloudhttp
FS_INC   = $(FS_DIR)/include/cloudfs
SYNC_INC = $(SYNC_DIR)/include/cloudsync

# AMISSL_INC before NDK_INC/RUNTIME_INC -- see libcloudhttp/Makefile.amiga-cross
CFLAGS  = $(TARGET) -O2 -DAMIGA -DPLATFORM_AMIGA -cpu=$(CPU) -Isrc \
          -I$(SYNC_INC) -I$(CORE_INC) -I$(HTTP_INC) -I$(FS_INC) \
          -I$(AMISSL_INC) -I$(NET_INC) -I$(NDK_INC) -I$(RUNTIME_INC)
# -lmieee: parson (libcloudcore) and syncstate.c/webdav.c both use double
# arithmetic, which on a 68000 (no FPU) needs mathieeedoubbas.library's
# stub routines -- undefined-symbol link errors otherwise.
LDFLAGS = $(TARGET) -L$(RUNTIME_LIB) -lmieee

OBJDIR = obj/amiga
BINDIR = ../../bin/amiga
TARGET_BIN = $(BINDIR)/AmiOwnCloudSync

CORE_SRCS = config base64 parson md5 ui_hooks cloudtime progress wbstartup
CORE_OBJS = $(CORE_SRCS:%=$(OBJDIR)/core_%.o)
HTTP_SRCS = cmd http_amiga
HTTP_OBJS = $(HTTP_SRCS:%=$(OBJDIR)/http_%.o)
FS_SRCS   = localfs_amiga localfs_util pattern_amiga
FS_OBJS   = $(FS_SRCS:%=$(OBJDIR)/fs_%.o)
SYNC_SRCS = sync syncstate webdav
SYNC_OBJS = $(SYNC_SRCS:%=$(OBJDIR)/sync_%.o)

OWN_SRCS = main commodity timer gui pairs
OWN_OBJS = $(OWN_SRCS:%=$(OBJDIR)/%.o)

all: $(OBJDIR) $(BINDIR) $(TARGET_BIN)

$(OBJDIR) $(BINDIR):
	mkdir -p $@

$(TARGET_BIN): $(OWN_OBJS) $(SYNC_OBJS) $(HTTP_OBJS) $(FS_OBJS) $(CORE_OBJS)
	$(CC) $(LDFLAGS) -o $(TARGET_BIN) $(OWN_OBJS) $(SYNC_OBJS) $(HTTP_OBJS) $(FS_OBJS) $(CORE_OBJS)

$(OBJDIR)/%.o: src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/sync_%.o: $(SYNC_DIR)/src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/core_%.o: $(CORE_DIR)/src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/http_%.o: $(HTTP_DIR)/src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/fs_%.o: $(FS_DIR)/src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

# Header dependencies: vbcc writes no dependency files usable here (its
# -deps output lands next to the sources, i.e. inside core/), so every
# object depends on all project headers on its include path -- a changed
# header rebuilds the whole program. SDK headers under $(VBCC) are left out.
PROJECT_HEADERS = $(wildcard src/*.h $(patsubst -I%,%/*.h,$(filter-out -I$(VBCC)/%,\
                  $(filter -I%,$(CFLAGS) $(HANDLER_CFLAGS) $(WORKER_CFLAGS)))))
$(OWN_OBJS) $(CORE_OBJS) $(HTTP_OBJS) $(FS_OBJS) $(SYNC_OBJS) $(VCS_OBJS) \
$(GUILIB_OBJS) $(HANDLER_OBJS) $(WORKER_OBJS) $(OBJS): $(PROJECT_HEADERS)

clean:
	rm -rf $(OBJDIR)
	rm -f $(TARGET_BIN)

.PHONY: all clean
