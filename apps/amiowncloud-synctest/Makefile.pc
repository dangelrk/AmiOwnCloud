# Copyright (C) 2026 Ronny Krueger
# amiowncloud-synctest — console test suite for the WebDAV sync transport,
# linked against libcloudsync + libcloudhttp + libcloudfs + libcloudcore.
# Runs on PC/Mac for fast iteration; cross-compiles for AmigaOS via
# Makefile.amiga-cross so the identical checks run on real/emulated
# Amiga hardware too — see src/main.c.
#
# Build:   make -f Makefile.pc

CC = gcc

LIBS_DIR = ../../core
CORE_DIR = $(LIBS_DIR)/libcloudcore
HTTP_DIR = $(LIBS_DIR)/libcloudhttp
FS_DIR   = $(LIBS_DIR)/libcloudfs
SYNC_DIR = $(LIBS_DIR)/libcloudsync

CORE_INC = $(CORE_DIR)/include/cloudcore
HTTP_INC = $(HTTP_DIR)/include/cloudhttp
FS_INC   = $(FS_DIR)/include/cloudfs
SYNC_INC = $(SYNC_DIR)/include/cloudsync

PKG_CF  := $(shell pkg-config --cflags libcurl 2>/dev/null)
PKG_LF  := $(shell pkg-config --libs   libcurl 2>/dev/null)
ifeq ($(PKG_CF),)
  PKG_CF := -I/opt/homebrew/include -I/usr/local/include
  PKG_LF := -L/opt/homebrew/lib -L/usr/local/lib -lcurl
endif

CFLAGS  = -MMD -MP -O2 -Wall -Wextra -std=c99 -I$(SYNC_INC) -I$(CORE_INC) -I$(HTTP_INC) -I$(FS_INC) $(PKG_CF)

OBJDIR = obj/pc
BINDIR = ../../bin/pc
LIBDIR = ../../lib/pc
LDFLAGS = -L$(LIBDIR) $(PKG_LF)

TARGET = $(BINDIR)/amiowncloud-synctest
OBJS   = $(OBJDIR)/main.o

all: libs $(TARGET)

# Static libraries this program links. Each archive is (re)built by its
# own Makefile.pc (FORCE: always asked, it knows its sources); the program
# is relinked only when one of them actually changed.
LIB_ARCHIVES = $(LIBDIR)/libcloudcore.a \
               $(LIBDIR)/libcloudhttp.a \
               $(LIBDIR)/libcloudfs.a \
               $(LIBDIR)/libcloudsync.a

libs: $(LIB_ARCHIVES)

$(LIBDIR)/libcloudcore.a: FORCE
	$(MAKE) -C $(CORE_DIR) -f Makefile.pc

$(LIBDIR)/libcloudhttp.a: FORCE
	$(MAKE) -C $(HTTP_DIR) -f Makefile.pc

$(LIBDIR)/libcloudfs.a: FORCE
	$(MAKE) -C $(FS_DIR) -f Makefile.pc

$(LIBDIR)/libcloudsync.a: FORCE
	$(MAKE) -C $(SYNC_DIR) -f Makefile.pc

FORCE:

$(TARGET): $(OBJS) $(LIB_ARCHIVES) | $(BINDIR)
	$(CC) $(CFLAGS) -o $@ $(OBJS) -lcloudsync -lcloudhttp -lcloudfs -lcloudcore $(LDFLAGS)

$(OBJDIR)/%.o: src/%.c | $(OBJDIR)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJDIR) $(BINDIR):
	mkdir -p $@

# Header dependencies, generated by the compiler (-MMD -MP above): a
# changed header recompiles every object that includes it.
-include $(wildcard $(OBJDIR)/*.d)

clean:
	rm -rf $(OBJDIR)
	rm -f $(TARGET)

.PHONY: all libs FORCE clean

# Build date for the $VER string (dd.mm.yyyy, see core version.h);
# the top-level make passes the same date to every program.
AC_BUILD_DATE ?= $(shell date +%d.%m.%Y)
CFLAGS += -DAC_BUILD_DATE=$(AC_BUILD_DATE)
